    "title":"",
    "date":"",
    "content":"<style>main{padding:20px;}h1{text-align:center;margin-bottom:10px;}.filter{text-align:center;margin-bottom:20px;}button{margin:5px;padding:8px 15px;border:none;border-radius:20px;cursor:pointer;background: var(--accent);transition:0.3s;}button:hover{background:#3b82f6;}.quotes-container{display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:20px;}.card:hover{transform:translateY(-5px);}.tag{font-size:12px;color:#60a5fa;margin-bottom:5px;}.quote-text{font-style:italic;margin-bottom:10px;}.meta{font-size:12px;color:#94a3b8;}</style><main><h1>Quotes Collection</h1><small id=\"count\"></small><div class=\"filter\" id=\"filterButtons\"></div><div class=\"quotes-container\" id=\"quotesContainer\"></div></main><script>const container = document.getElementById(\"quotesContainer\");const filterButtons = document.getElementById(\"filterButtons\");let countQuotes = 0;fetch(\"data/quotes.json\").then(res => res.json()).then(quotes =>{function displayQuotes(filterTag = \"All\"){container.innerHTML = \"\";const filtered =filterTag === \"All\"? quotes:quotes.filter((q) => q.tag === filterTag);filtered.forEach((q) =>{const card = document.createElement(\"div\");card.className = \"card\";card.innerHTML = ` <div class=\"tag\">#${q.tag}</div> <div class=\"quote-text\">\"${q.quote}\"</div> <div class=\"meta\">${q.author} • ${q.date}</div> `;container.appendChild(card);countQuotes += 1});document.getElementById(\"count\").textContent = `There are ${countQuotes} quotes`;countQuotes = 0;}function generateFilters(){const tags = [\"All\", ...new Set(quotes.map((q) => q.tag))];tags.forEach((tag) =>{const btn = document.createElement(\"button\");btn.textContent = tag;btn.onclick = () => displayQuotes(tag);filterButtons.appendChild(btn);});}generateFilters();displayQuotes();});</script>"
}